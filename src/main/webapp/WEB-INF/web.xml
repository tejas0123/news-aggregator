<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd" version="6.0">

  <display-name>news-aggregator</display-name>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.htm</welcome-file>
    <welcome-file>index.jsp</welcome-file>
    <welcome-file>default.html</welcome-file>
    <welcome-file>default.htm</welcome-file>
    <welcome-file>default.jsp</welcome-file>
  </welcome-file-list>
  <servlet>
    <description></description>
    <display-name>Login</display-name>
    <servlet-name>Login</servlet-name>
    <servlet-class>servlets.Login</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>Signup</display-name>
    <servlet-name>Signup</servlet-name>
    <servlet-class>servlets.Signup</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Signup</servlet-name>
    <url-pattern>/api/v1/auth/signup</url-pattern>
  </servlet-mapping>
  <listener>
    <listener-class>newsprovider.NewsAPIScheduler</listener-class>
  </listener>
  <servlet>
    <description></description>
    <display-name>Search</display-name>
    <servlet-name>Search</servlet-name>
    <servlet-class>servlets.Search</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Search</servlet-name>
    <url-pattern>/api/v1/articles</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>SaveArticle</display-name>
    <servlet-name>SaveArticle</servlet-name>
    <servlet-class>servlets.SaveArticle</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SaveArticle</servlet-name>
    <url-pattern>/api/v1/articles/saved</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>ArticlesMetadata</display-name>
    <servlet-name>ArticlesMetadata</servlet-name>
    <servlet-class>servlets.ArticlesMetadata</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ArticlesMetadata</servlet-name>
    <url-pattern>/api/v1/articles/metadata</url-pattern>
  </servlet-mapping>
  <servlet>
    <description></description>
    <display-name>NotificationPreferences</display-name>
    <servlet-name>NotificationPreferences</servlet-name>
    <servlet-class>servlets.NotificationPreferences</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>NotificationPreferences</servlet-name>
    <url-pattern>/api/v1/notification/preference/category</url-pattern>
  </servlet-mapping>
</web-app>